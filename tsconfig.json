{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@charles7c/git-forge": ["./packages/git-forge/src/index.ts"]
    }
  },
  "include": [
    "vitest.config.ts",
    "vitest.e2e.config.ts",
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/e2e/**/*.ts",
    "packages/*/tsup.config.ts"
  ]
}
