{
  "name": "@charles7c/git-forge",
  "version": "0.1.0",
  "description": "One GitHub-shaped TypeScript API for the Issue, Pull Request, Repository, Files and Branch/Commit domains of GitHub, Gitee and AtomGit.",
  "keywords": [
    "github",
    "gitee",
    "atomgit",
    "sdk",
    "api-client",
    "mcp"
  ],
  "license": "MIT",
  "author": "Charles7c",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Charles7c/git-forge.git",
    "directory": "packages/git-forge"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "dependencies": {},
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
